# --- Zorunlu ---
DATABASE_URL=postgres://eksen:eksen_dev@localhost:5432/eksen
# Kanonik site adresi (sitemap, canonical, OG için). Production'da gerçek domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Seed ile oluşturulacak ilk yönetici
ADMIN_EMAIL=yonetim@eksen.local
ADMIN_PASSWORD=degistir-beni-uzun-bir-sifre

# --- Ödeme (iyzico pazaryeri) — boş bırakılırsa sandbox sağlayıcı çalışır ---
PAYMENT_PROVIDER=sandbox
# Yalnızca yerel/staging: production derlemesinde sandbox ödemeye izin verir. Canlıda ASLA true yapmayın.
ALLOW_SANDBOX_PAYMENTS=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- E-posta — boş bırakılırsa e-postalar yalnızca outbox tablosuna yazılır ---
# Cloudflare Workers'ta HTTP tabanlı Resend kullanılır (SMTP soketi açılamaz). Node sunucusunda SMTP de olur.
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM="Eksen <bildirim@eksen.local>"

# --- Yönetici güvenliği ---
# İki adımlı doğrulama sırlarını veritabanında AES-GCM ile şifreler. En az 32 karakter, rastgele:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOTP_ENCRYPTION_KEY=
# true: yönetici, 2FA kurmadan yönetim sayfalarını kullanamaz (canlıda önerilir)
ADMIN_2FA_REQUIRED=false

# --- Zamanlanmış görevler (otomatik onay vb.) için gizli anahtar ---
CRON_SECRET=uzun-rastgele-bir-deger

# --- Dosya yükleme dizini (yalnızca Node kurulumu; Cloudflare'de R2 "UPLOADS" bağlantısı kullanılır) ---
UPLOAD_DIR=./storage/uploads

# --- Arama motoru doğrulama ---
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
